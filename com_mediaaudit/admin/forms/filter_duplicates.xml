<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" label="COM_MEDIAAUDIT_FILTER_SEARCH" description="COM_MEDIAAUDIT_FILTER_SEARCH_DESC" hint="COM_MEDIAAUDIT_FILTER_SEARCH" inputmode="search"/>
        <field name="derived" type="list" label="COM_MEDIAAUDIT_FILTER_DERIVED" description="COM_MEDIAAUDIT_FILTER_DERIVED_DESC" default="0" class="js-select-submit-on-change" validate="options">
            <option value="0">COM_MEDIAAUDIT_FILTER_DERIVED_NO</option>
            <option value="1">COM_MEDIAAUDIT_FILTER_DERIVED_YES</option>
        </field>
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="wasted DESC" class="js-select-submit-on-change" validate="options">
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="wasted DESC">COM_MEDIAAUDIT_SORT_WASTED_DESC</option>
            <option value="size DESC">COM_MEDIAAUDIT_SORT_SIZE_DESC</option>
            <option value="copies DESC">COM_MEDIAAUDIT_SORT_COPIES_DESC</option>
        </field>
        <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" class="js-select-submit-on-change"/>
    </fields>
</form>
