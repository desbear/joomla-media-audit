<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" label="COM_MEDIAAUDIT_FILTER_SEARCH" description="COM_MEDIAAUDIT_FILTER_SEARCH_DESC" hint="COM_MEDIAAUDIT_FILTER_SEARCH" inputmode="search"/>
        <field name="state" type="list" label="COM_MEDIAAUDIT_FILTER_STATE" default="held" class="js-select-submit-on-change" validate="options">
            <option value="held">COM_MEDIAAUDIT_FILTER_STATE_HELD</option>
            <option value="restored">COM_MEDIAAUDIT_FILTER_STATE_RESTORED</option>
            <option value="deleted">COM_MEDIAAUDIT_FILTER_STATE_DELETED</option>
            <option value="all">JALL</option>
        </field>
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="q.id DESC" class="js-select-submit-on-change" validate="options">
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="q.id DESC">COM_MEDIAAUDIT_SORT_MOVED_DESC</option>
            <option value="q.id ASC">COM_MEDIAAUDIT_SORT_MOVED_ASC</option>
            <option value="q.original_path ASC">COM_MEDIAAUDIT_SORT_PATH_ASC</option>
            <option value="q.original_path DESC">COM_MEDIAAUDIT_SORT_PATH_DESC</option>
        </field>
        <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" class="js-select-submit-on-change"/>
    </fields>
</form>
